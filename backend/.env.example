# Gemini (Interactions API) - free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
TRACE_GEMINI_MODEL=gemini-3.5-flash
TRACE_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Knowledge graph: "networkx" (in-process, zero setup) or "neo4j"
TRACE_GRAPH_BACKEND=networkx
TRACE_NEO4J_URI=bolt://localhost:7687
TRACE_NEO4J_USER=neo4j
TRACE_NEO4J_PASSWORD=trace-password

# Review similarity: "fastembed" (local MiniLM embeddings) or "tfidf"
TRACE_EMBEDDER=fastembed

# Where trace.db lives (default: auto-detected in <repo>/data, backend/data or cwd)
# TRACE_DATA_DIR=../data
# TRACE_DB_PATH=../data/trace.db

# MCP server (see docs/MCP_AND_GOVERNANCE.md). Entries: token:role:principal, roles viewer|analyst|reviewer|admin.
# Generate tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRACE_MCP_ENABLED=true
TRACE_MCP_API_KEYS=
TRACE_MCP_ALLOW_ANONYMOUS=false
TRACE_MCP_RATE_LIMIT_PER_MIN=60
TRACE_MCP_ANALYSIS_RATE_LIMIT_PER_MIN=6
TRACE_MCP_STDIO_ROLE=analyst

# Data governance (see docs/DATA_GOVERNANCE.md)
# Third-party processors cleared to receive data. Prototype: gemini,neo4j approved. Production (local LLM + local DB): leave empty.
TRACE_APPROVED_PROCESSORS=gemini,neo4j
TRACE_LLM_EGRESS_MODE=redacted
TRACE_RETENTION_ANALYSES_DAYS=365
TRACE_RETENTION_EGRESS_DAYS=180
TRACE_RETENTION_DECISIONS_DAYS=1095
TRACE_RETENTION_AUDIT_DAYS=730
