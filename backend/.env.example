# Gemini (Interactions API) - free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
TRACE_GEMINI_MODEL=gemini-3.5-flash
TRACE_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Knowledge graph: "networkx" (in-process, zero setup) or "neo4j"
TRACE_GRAPH_BACKEND=networkx
TRACE_NEO4J_URI=bolt://localhost:7687
TRACE_NEO4J_USER=neo4j
TRACE_NEO4J_PASSWORD=trace-password

# Review similarity: "fastembed" (local MiniLM embeddings) or "tfidf"
TRACE_EMBEDDER=fastembed
